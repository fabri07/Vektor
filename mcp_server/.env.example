ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-at-least-32-chars
DATABASE_URL=postgresql://user:password@localhost:5432/vektor

# Shared secret expected from the main backend in X-MCP-Server-Secret.
MCP_SERVER_SHARED_SECRET=

# Google OAuth for MCP product integrations.
# These are not paid tokens. Google issues access/refresh tokens after a
# successful OAuth consent flow.
GOOGLE_MCP_OAUTH_CLIENT_ID=
GOOGLE_MCP_OAUTH_CLIENT_SECRET=
GOOGLE_MCP_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# Backwards-compatible fallback names. Avoid using these in production if the
# main backend also uses Google social login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

GOOGLE_OAUTH_TIMEOUT_SECONDS=20.0
